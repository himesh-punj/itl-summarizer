# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  GST Legal AI — Environment Configuration                               ║
# ║  Copy this file to .env and fill in ALL values                           ║
# ║  NEVER commit .env to git — add it to .gitignore                         ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DATABASE — Shared across all services
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DB_HOST=103.74.54.133
DB_PORT=5432
DB_NAME=IncomeTaxLibrary
DB_USER=postgres
DB_PASSWORD=                          # ⚠️  REQUIRED — paste your actual DB password here

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GROQ API KEYS — Separate keys per service for rate-limit isolation
# Get keys from: https://console.groq.com/keys
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# GST Notice Reply Agent (port 5002)
NOTICE_AGENT_GROQ_API_KEY=            # ⚠️  REQUIRED — gsk_xxxx for notice reply generation
NOTICE_AGENT_GROQ_MODEL=llama-3.1-8b-instant

# Legal Document Summarizer (port 5000)
SUMMARIZER_GROQ_API_KEY=              # ⚠️  REQUIRED — gsk_xxxx for summarization
SUMMARIZER_GROQ_MODEL=llama-3.1-8b-instant

# Main RAG Pipeline (port 8000) — used by api_wrapper_uat.py
GROQ_API_KEY=                         # ⚠️  REQUIRED — gsk_xxxx for main AI pipeline

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FLASK SECURITY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Flask session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=                     # ⚠️  REQUIRED — 64-char hex string

# API authentication key — clients must send this in Authorization: Bearer <key>
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_KEY=                         # ⚠️  RECOMMENDED — protects all POST endpoints

# Debug mode — ALWAYS set to false in production
FLASK_DEBUG=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CORS — Cross-Origin Resource Sharing
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Comma-separated list of allowed origins. Empty = block all cross-origin requests
# Example: https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# RATE LIMITING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Notice Agent: requests per minute per IP
NOTICE_AGENT_RATE_LIMIT=10
NOTICE_AGENT_RATE_WINDOW=60

# Summarizer: requests per minute per IP
SUMMARIZER_RATE_LIMIT=10
SUMMARIZER_RATE_WINDOW=60

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# NETWORK & PROXY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Number of trusted reverse proxies (nginx, load balancer) in front of Flask
# 0 = ignore X-Forwarded-For header (direct connections only)
# 1 = one proxy (e.g., nginx → Flask)
TRUSTED_PROXY_COUNT=0

# IP whitelist for summarizer (empty = allow all)
# Example: 192.168.1.100,10.0.0.50
ALLOWED_IPS=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SERVICE PORTS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

NOTICE_AGENT_PORT=5002
SUMMARIZER_PORT=5000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LM STUDIO (local model — fallback if Groq is unavailable)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=local-model
LM_STUDIO_TEMPERATURE=0.7
LM_STUDIO_MAX_TOKENS=2000
